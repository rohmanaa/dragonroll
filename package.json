{
  "name": "dragon-roll",
  "version": "1.0.0",
  "description": "Dragon Roll Desktop Game",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder",
    "preview": "vite preview",
    "start": "electron .",
    "electron": "electron .",
    "electron:build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "vite": "^8.4.0",
    "vite-plugin-static-copy": "^4.1.1"
  },
  "build": {
    "appId": "com.dragonroll.game",
    "productName": "Dragon Roll",
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!release/**/*",
      "!node_modules/.cache/**/*"
    ],
    "win": {
      "icon": "assets/icons/favicon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icons/favicon.ico",
      "uninstallerIcon": "assets/icons/favicon.ico"
    },
    "linux": {
      "category": "Game"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rohmanaa/dragonroll.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/rohmanaa/dragonroll.git/issues"
  },
  "homepage": "https://github.com/rohmanaa/dragonroll#readme"
}
